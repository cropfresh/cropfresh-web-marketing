# Optional local configuration. Real values belong in .env.local or host secret storage.
# NEXT_PUBLIC_* values are visible to browsers and must never contain secrets.
# Leave analytics/AI integrations disabled until their owner configuration is approved.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_AI_API_URL=

# Server-only administration key. Empty or missing configuration denies all lead reads.
ADMIN_API_KEY=
