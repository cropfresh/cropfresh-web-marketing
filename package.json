{
  "name": "cropfresh-web-marketing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.0 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm audit --omit=dev --audit-level=high && npm run build",
    "verify:phase0": "node scripts/verify-phase-0.mjs",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.12.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.3.8",
    "next-mdx-remote": "^6.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.70.0",
    "reading-time": "^1.5.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
